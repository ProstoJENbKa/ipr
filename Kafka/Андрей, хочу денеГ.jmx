        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="создаем consumer">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.util.Properties

import org.apache.kafka.clients.consumer.KafkaConsumer
import org.apache.kafka.common.serialization.StringDeserializer

Properties kafkaProps = new Properties()

kafkaProps.put(
        &quot;bootstrap.servers&quot;,
        &quot;192.168.56.101:9092,192.168.56.101:9093,192.168.56.101:9094&quot;
)

kafkaProps.put(
        &quot;key.deserializer&quot;,
        StringDeserializer.class.getName()
)

kafkaProps.put(
        &quot;value.deserializer&quot;,
        StringDeserializer.class.getName()
)

kafkaProps.put(&quot;group.id&quot;, &quot;jmeter-permanent-consumer&quot;)

kafkaProps.put(&quot;enable.auto.commit&quot;, &quot;true&quot;)

kafkaProps.put(&quot;auto.offset.reset&quot;, &quot;latest&quot;)


def consumer = new KafkaConsumer&lt;String, String&gt;(kafkaProps)

consumer.subscribe(
        Collections.singletonList(&quot;topic1&quot;)
)

props.put(&quot;kafkaConsumer&quot;, consumer)

log.info(&quot;Kafka Consumer created&quot;)</stringProp>
        </JSR223Sampler>

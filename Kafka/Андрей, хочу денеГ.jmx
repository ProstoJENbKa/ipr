      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="produser">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Properties

import org.apache.kafka.clients.producer.KafkaProducer
import org.apache.kafka.clients.producer.ProducerRecord
import org.apache.kafka.clients.producer.RecordMetadata
import org.apache.kafka.common.serialization.StringSerializer


// 1. Куда подключаемся
def brokers = &quot;192.168.56.101:9092,192.168.56.101:9093,192.168.56.101:9094&quot;

// 2. Куда отправляем
def topic = &quot;topic1&quot;

// 3. Что отправляем
def message = &quot;Андрей, зачти ипр, хочу денеГ&quot;


// 4. Настройки Kafka Producer
Properties kafkaProps = new Properties()

kafkaProps.put(&quot;bootstrap.servers&quot;, brokers)

kafkaProps.put(
        &quot;key.serializer&quot;,
        StringSerializer.class.getName()
)

kafkaProps.put(
        &quot;value.serializer&quot;,
        StringSerializer.class.getName()
)

kafkaProps.put(&quot;acks&quot;, &quot;all&quot;)


// 5. Создаем Kafka Producer
KafkaProducer&lt;String, String&gt; producer =
        new KafkaProducer&lt;&gt;(kafkaProps)

try {

    // 6. Создаем сообщение Kafka
    ProducerRecord&lt;String, String&gt; record =
            new ProducerRecord&lt;&gt;(topic, message)

    // 7. Отправляем сообщение и ждем подтверждения
    RecordMetadata metadata =
            producer.send(record).get()

    // 8. Пишем информацию в jmeter.log
    log.info(
            &quot;Kafka message sent. Topic={}, Partition={}, Offset={}&quot;,
            metadata.topic(),
            metadata.partition(),
            metadata.offset()
    )

    // 9. Помечаем JMeter sampler успешным
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(
            &quot;Kafka message sent. Partition=&quot; +
            metadata.partition() +
            &quot;, Offset=&quot; +
            metadata.offset()
    )

} catch (Exception e) {

    log.error(&quot;Kafka Producer error&quot;, e)

    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(e.toString())

} finally {

    // 10. Закрываем producer
    producer.close()
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="consumer">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.time.Duration
import java.util.Properties
import java.util.UUID

import org.apache.kafka.clients.consumer.KafkaConsumer
import org.apache.kafka.common.serialization.StringDeserializer


def brokers = &quot;192.168.56.101:9092,192.168.56.101:9093,192.168.56.101:9094&quot;
def topic = &quot;topic1&quot;


Properties kafkaProps = new Properties()

kafkaProps.put(&quot;bootstrap.servers&quot;, brokers)

kafkaProps.put(
        &quot;key.deserializer&quot;,
        StringDeserializer.class.getName()
)

kafkaProps.put(
        &quot;value.deserializer&quot;,
        StringDeserializer.class.getName()
)

// Уникальная consumer group для каждого запуска
kafkaProps.put(
        &quot;group.id&quot;,
        &quot;jmeter-consumer-&quot; + UUID.randomUUID().toString()
)

kafkaProps.put(&quot;enable.auto.commit&quot;, &quot;false&quot;)

// Если у группы ещё нет offset — читать с начала
kafkaProps.put(&quot;auto.offset.reset&quot;, &quot;earliest&quot;)


KafkaConsumer&lt;String, String&gt; consumer =
        new KafkaConsumer&lt;&gt;(kafkaProps)

try {

    consumer.subscribe(Collections.singletonList(topic))

    long endTime = System.currentTimeMillis() + 10000

    int messageCount = 0
    StringBuilder result = new StringBuilder()

    while (System.currentTimeMillis() &lt; endTime &amp;&amp; messageCount == 0) {

        def records = consumer.poll(Duration.ofMillis(1000))

        records.each { record -&gt;

            messageCount++

            def line =
                    &quot;Topic=${record.topic()}, &quot; +
                    &quot;Partition=${record.partition()}, &quot; +
                    &quot;Offset=${record.offset()}, &quot; +
                    &quot;Value=${record.value()}&quot;

            log.info(line)

            result.append(line).append(&quot;\n&quot;)
        }
    }

    if (messageCount &gt; 0) {

        SampleResult.setSuccessful(true)
        SampleResult.setResponseCode(&quot;200&quot;)
        SampleResult.setResponseMessage(
                &quot;Read ${messageCount} Kafka messages&quot;
        )

        SampleResult.setResponseData(
                result.toString(),
                &quot;UTF-8&quot;
        )

    } else {

        SampleResult.setSuccessful(false)
        SampleResult.setResponseCode(&quot;404&quot;)
        SampleResult.setResponseMessage(
                &quot;No Kafka messages received&quot;
        )
    }

} catch (Exception e) {

    log.error(&quot;Kafka Consumer error&quot;, e)

    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(e.toString())

} finally {

    consumer.close()
}</stringProp>
        </JSR223Sampler>
